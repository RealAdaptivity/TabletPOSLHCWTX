{
  "expo": {
    "name": "Tablet POS LHCW",
    "slug": "tabletposlhcwtx",
    "version": "0.1.0",
    "orientation": "default",
    "scheme": "lhcw",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0B1220"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lhcw.tabletpos"
    },
    "android": {
      "package": "com.lhcw.tabletpos"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
